<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>livox_ros_driver2</name>
  <version>1.0.0</version>
  <description>The ROS device driver for Livox 3D LiDARs, for ROS2</description>
  <maintainer email="871609336@qq.com">Qi Tuo</maintainer>
  <license>Proprietary</license>

  <build_depend>rosidl_default_generators</build_depend>

  <depend>Livox-SDK2</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_cppcheck</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>libxml2-utils</test_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>rc</build_type>
  </export>
</package>
