@PACKAGE_INIT@
list(APPEND livox_ros_driver2_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include/livox_ros_driver2")
foreach(_livox_driver_dependency IN ITEMS Livox-SDK2 rclcpp rclcpp_components sensor_msgs)
  find_dependency(${_livox_driver_dependency})
  list(APPEND livox_ros_driver2_DEPENDENCIES "${_livox_driver_dependency}")
  list(APPEND livox_ros_driver2_RECURSIVE_DEPENDENCIES
    "${_livox_driver_dependency}" ${${_livox_driver_dependency}_RECURSIVE_DEPENDENCIES})
endforeach()
list(REMOVE_DUPLICATES livox_ros_driver2_RECURSIVE_DEPENDENCIES)

include("${CMAKE_CURRENT_LIST_DIR}/livoxDriverTargets.cmake")
list(APPEND livox_ros_driver2_LIBRARIES livox_ros_driver2::driver)
foreach(_livox_driver_target IN ITEMS
    rclcpp::rclcpp rclcpp_components::component sensor_msgs::sensor_msgs__rosidl_generator_cpp)
  get_target_property(_livox_driver_includes "${_livox_driver_target}" INTERFACE_INCLUDE_DIRECTORIES)
  if(_livox_driver_includes)
    list(APPEND livox_ros_driver2_INCLUDE_DIRS ${_livox_driver_includes})
  endif()
endforeach()
list(REMOVE_DUPLICATES livox_ros_driver2_INCLUDE_DIRS)
unset(_livox_driver_includes)
